# FFAX browser-side ZITADEL OIDC configuration.
# These values are public SPA configuration, not client secrets.
VITE_ZITADEL_DOMAIN=http://localhost:8080
VITE_ZITADEL_CLIENT_ID=replace-with-zitadel-web-application-client-id
VITE_ZITADEL_PROJECT_ID=replace-with-ffax-project-id
VITE_ZITADEL_CALLBACK_URL=http://localhost:5002/authentication/callback
VITE_ZITADEL_POST_LOGOUT_URL=http://localhost:5002/pages/landing/homepage
VITE_ZITADEL_ACCOUNT_URL=http://localhost:8080/ui/console/users/me
VITE_POST_LOGIN_URL=/dashboard/ecommerce
VITE_ZITADEL_SCOPE=openid profile email offline_access urn:zitadel:iam:user:resourceowner urn:zitadel:iam:org:projects:roles
VITE_API_URL=http://localhost:8000/api
VITE_MARKETPLACE_API_URL=http://localhost:9000
