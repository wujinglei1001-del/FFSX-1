# FFAX browser-side ZITADEL OIDC configuration.
# These values are public SPA configuration, not client secrets.
VITE_ZITADEL_DOMAIN=http://localhost:8080
VITE_ZITADEL_CLIENT_ID=replace-with-zitadel-web-application-client-id
VITE_ZITADEL_PROJECT_ID=replace-with-ffax-project-id
VITE_ZITADEL_CALLBACK_URL=http://localhost:5002/authentication/callback
VITE_ZITADEL_POST_LOGOUT_URL=http://localhost:5002/authentication/zitadel/logged-out
VITE_ZITADEL_ACCOUNT_URL=http://localhost:8080/ui/console/users/me
VITE_POST_LOGIN_URL=/workbench
VITE_ZITADEL_SCOPE=openid profile email offline_access urn:zitadel:iam:user:resourceowner urn:zitadel:iam:org:projects:roles

# Optional FFAX-owned public pages and official social accounts.
VITE_FFAX_WEBSITE_URL=
VITE_FFAX_CONTACT_EMAIL=
VITE_FFAX_CONTACT_PHONE=
VITE_FFAX_CONTACT_LOCATION=
VITE_FFAX_PRIVACY_URL=
VITE_FFAX_COOKIE_URL=
VITE_FFAX_TERMS_URL=
VITE_FFAX_SECURITY_URL=
VITE_FFAX_FACEBOOK_URL=
VITE_FFAX_INSTAGRAM_URL=
VITE_FFAX_THREADS_URL=
VITE_FFAX_X_URL=
VITE_FFAX_NOTION_URL=
VITE_FFAX_YOUTUBE_URL=
VITE_FFAX_PINTEREST_URL=
VITE_FFAX_TIKTOK_URL=
VITE_API_URL=http://localhost:8000/api

# Optional local/build metadata. Production defaults to /workbench/ when no basename is set.
VITE_APP_PORT=5002
# VITE_BASENAME=/workbench/
VITE_ASSET_BASE_URL=/assets
# VITE_APP_VERSION=

# Keep disabled in production. Enable only when explicitly reviewing the retained source-template pages.
VITE_ENABLE_TEMPLATE_PREVIEW=false
# VITE_MAPBOX_ACCESS_TOKEN=
