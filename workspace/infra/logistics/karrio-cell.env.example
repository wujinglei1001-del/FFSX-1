COMPOSE_PROJECT_NAME=ffax-karrio-tenant-cell-id
KARRIO_CELL_ID=tenant-cell-id
KARRIO_SECRET_KEY=replace-with-a-random-64-character-secret
KARRIO_DATABASE_PASSWORD=replace-with-an-independent-random-password
KARRIO_REDIS_PASSWORD=replace-with-an-independent-random-password
KARRIO_ADMIN_EMAIL=service-account@ffax.invalid
KARRIO_ADMIN_PASSWORD=replace-with-an-independent-random-password
KARRIO_PLUGINS_DIR=/etc/ffax/karrio/tenant-cell-id/plugins
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
