# Copy to .env on the server and replace every value. Do not reuse a human password.
FFAX_DATABASE_NAME=ffax_platform
FFAX_DATABASE_USER=ffax_platform
FFAX_DATABASE_PASSWORD=replace-with-random-database-password
FFAX_REDIS_PASSWORD=replace-with-random-redis-password
MERCUR_DATABASE_NAME=mercur
MERCUR_DATABASE_USER=mercur
MERCUR_DATABASE_PASSWORD=replace-with-different-random-password
MERCUR_IMAGE=ffax/mercur:2.3.1
MERCUR_ENV_FILE=/etc/ffax/platform/mercur.env
