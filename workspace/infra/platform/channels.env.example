FFAX_CHANNEL_IMAGE=ffax/channel-runtime:1.0.0
FFAX_ALLOWED_ORIGINS=https://www.ffax.com
FFAX_INGRESS_SHARED_TOKEN=replace-with-a-random-64-character-secret
FFAX_RUNTIME_HEARTBEAT_TOKEN=replace-with-another-random-64-character-secret
FFAX_CONTROL_PLANE_URL=http://ffax-api:8000
OPENBAO_ENV_DIR=/etc/ffax/openbao/apps

WAREHOUSE_DATABASE_PASSWORD=replace-with-independent-random-password
MARKETPLACE_CHANNEL_DATABASE_PASSWORD=replace-with-independent-random-password
LOGISTICS_DATABASE_PASSWORD=replace-with-independent-random-password
COMMERCE_DATABASE_PASSWORD=replace-with-independent-random-password
SYNC_DATABASE_PASSWORD=replace-with-independent-random-password

ZITADEL_ISSUER=https://www.ffax.com
ZITADEL_PROJECT_ID=replace-with-zitadel-project-id
ZITADEL_API_CLIENT_ID=replace-with-zitadel-api-client-id
ZITADEL_API_CLIENT_SECRET=replace-with-zitadel-api-client-secret
