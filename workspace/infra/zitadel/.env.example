# Local development defaults. Replace all marked secrets before use.
ZITADEL_DOMAIN=localhost
PROXY_HTTP_PUBLISHED_PORT=8080
ZITADEL_EXTERNALPORT=8080
ZITADEL_EXTERNALSECURE=false
ZITADEL_PUBLIC_SCHEME=http
ZITADEL_PUBLIC_URL=http://localhost:8080
ZITADEL_INSTANCE_HOST=localhost:8080

# Must be exactly 32 characters. Do not commit the real value.
ZITADEL_MASTERKEY=replace-with-32-character-secret
LOGIN_CLIENT_PAT_EXPIRATION=2099-01-01T00:00:00Z
ADMIN_PAT_EXPIRATION=2099-01-01T00:00:00Z

ZITADEL_FIRSTINSTANCE_ORG_NAME=FFAX
ZITADEL_ADMIN_USERNAME=mamawel
ZITADEL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
ZITADEL_ADMIN_EMAIL=admin@ffax.local

# Optional outbound mail. Required for self-registration verification and password reset.
# QQ Mail example: smtp.qq.com:465, TLS=true, and use a QQ SMTP authorization code as password.
ZITADEL_SMTP_HOST=
ZITADEL_SMTP_USER=
ZITADEL_SMTP_PASSWORD=
ZITADEL_SMTP_TLS=false
ZITADEL_SMTP_FROM=
ZITADEL_SMTP_FROM_NAME=FFAX
ZITADEL_SMTP_REPLY_TO=

FFAX_FRONTEND_URL=http://localhost:5002
FFAX_CALLBACK_URL=http://localhost:5002/authentication/callback
FFAX_POST_LOGOUT_URL=http://localhost:5002/pages/landing/homepage
FFAX_API_URL=http://localhost:8000/api
FFAX_MARKETPLACE_API_URL=http://localhost:9000
FFAX_DEV_MODE=true
FFAX_API_IMAGE=ffax/api:current
FFAX_API_ENV_FILE=/etc/ffax/platform/ffax-api.env

# Official, pinned images. Upgrade by changing the version deliberately.
ZITADEL_VERSION=v4.15.0
TRAEFIK_IMAGE=traefik:v3.6.8
POSTGRES_IMAGE=postgres:17.2-alpine

TRAEFIK_DASHBOARD_ENABLED=false
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_ACCESSLOG_ENABLED=true

POSTGRES_DB=zitadel
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-strong-password
ZITADEL_DATABASE_POSTGRES_DSN=postgresql://postgres:replace-with-a-strong-password@postgres:5432/zitadel?sslmode=disable

ZITADEL_ACCESS_LOG_STDOUT_ENABLED=true
