{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "5.0",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "paths": {
      "*": ["./src/*"]
    }

    // "checkJs": true
    // "strict": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
