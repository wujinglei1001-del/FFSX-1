{
  "name": "vite-js",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' vite",
    "api": "node server/index.js",
    "api:report": "node scripts/api-reporting/generate.mjs",
    "api:report:check": "node scripts/api-reporting/check.mjs",
    "auth:setup": "powershell -ExecutionPolicy Bypass -File ./infra/zitadel/setup.ps1",
    "prebuild": "npm run api:report:check",
    "build": "npm run build:host && npm run build:root-home",
    "build:host": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "build:root-home": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build --base=/ --outDir=dist-root",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "pretty": "prettier --write ."
  },
  "dependencies": {
