PORT=8000
FFAX_ALLOWED_ORIGINS=http://localhost:5002
FFAX_DATABASE_URL=postgres://ffax_platform:replace-with-random-password@localhost:5433/ffax_platform
FFAX_REDIS_URL=redis://localhost:6380
MERCUR_BASE_URL=http://localhost:9000
# Keep disabled until the enterprise payment account has passed KYC.
FFAX_ENABLE_REAL_PAYMENTS=false
FFAX_RUNTIME_HEARTBEAT_TOKEN=replace-with-independent-random-runtime-token
FFAX_CHANNEL_HEARTBEAT_TIMEOUT_MS=45000
OTEL_SERVICE_NAME=ffax-control-plane
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces

ZITADEL_ISSUER=http://localhost:8080
ZITADEL_PROJECT_ID=replace-with-ffax-project-id
ZITADEL_API_CLIENT_ID=replace-with-zitadel-api-client-id
ZITADEL_API_CLIENT_SECRET=replace-with-zitadel-api-client-secret
# Optional override. Defaults to ZITADEL_ISSUER/oauth/v2/introspect.
ZITADEL_INTROSPECTION_URL=
