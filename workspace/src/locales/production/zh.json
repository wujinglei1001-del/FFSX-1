    "faq": {
      "categories": {
        "platform": {
          "title": "FFA-X 平台",
          "description": "了解全球贸易可信数字桥梁的组织方式。",
          "items": {
            "overview": {
              "question": "什么是 FFA-X？",
              "answer": "FFA-X 是全球贸易网络中的可信数字桥梁，通过统一工作台连接组织、团队、服务能力、业务资源与履约流程。"
            },
            "participants": {
              "question": "FFA-X 连接哪些参与方？",
              "answer": "FFA-X 面向买家、卖家、工厂、物流服务商、仓库、专业服务组织，以及负责完成跨境业务的各类团队。"
            },
            "ai": {
              "question": "AI 在 FFA-X 中承担什么角色？",
              "answer": "AI 是用于理解需求、匹配能力和辅助工作的支持层。业务决策、权限和交易仍由已连接的系统、服务器 API 与获授权用户控制。"
            },
            "modules": {
              "question": "工作台包含哪些模块？",
              "answer": "工作台通过可保存的标签与分屏组织已授权功能，目前可使用插件中心与通知；其他业务模块会按组织权限开放。"
            }
          }
        },
        "access": {
          "title": "账号与访问",
          "description": "身份、登录、受保护页面与组织访问。",
          "items": {
            "login": {
              "question": "如何登录？",
              "answer": "FFA-X 通过统一身份服务完成登录与账号注册。"
            },
            "protection": {
              "question": "未登录可以进入工作台吗？",
              "answer": "不可以。受保护的工作台路由要求有效登录会话，未登录访问会跳转到 ZITADEL 登录页。"
            },
            "roles": {
              "question": "组织角色如何生效？",
              "answer": "FFA-X 从已认证身份中读取组织和项目角色声明；服务器 API 必须在每项受保护操作中执行对应的租户与权限规则。"
            },
            "logout": {
              "question": "退出登录后会发生什么？",
              "answer": "退出操作会通过已配置的身份提供方结束 FFA-X 会话，并返回正式的退出完成页面。"
            }
          }
        },
        "connections": {
          "title": "系统与 API",
          "description": "真实服务、工作页与业务数据的连接方式。",
          "items": {
            "api": {
              "question": "FFA-X 如何连接业务系统？",
              "answer": "FFA-X 通过服务适配器连接各业务系统，在统一工作台中协调信息、任务与流程。"
            },
            "workspace": {
              "question": "功能模块会嵌入外部网页吗？",
              "answer": "不会。功能模块直接运行在 FFA-X 工作台中，并统一使用系统的主题、控件和窗口交互。"
            },
            "records": {
              "question": "生产业务记录来自哪里？",
              "answer": "业务记录由已连接的系统同步，并依据组织与用户权限在工作台中显示。"
            },
            "transactions": {
              "question": "FFA-X 会替代所有交易平台吗？",
              "answer": "不会。独立交易和服务平台继续保留自身权责，FFA-X 负责跨系统连接参与方、能力、信息与业务流程。"
            }
          }
        },
        "workbench": {
          "title": "工作台与界面",
          "description": "导航、响应式布局、语言与显示设置。",
          "items": {
            "navigation": {
              "question": "首页文字和按钮会跳转到哪里？",
              "answer": "正式导航指向 FFA-X 的真实路由，包括首页、关于我们、联系我们、常见问题、订阅、登录和受保护工作台；未配置的外部链接不会伪装成可用服务。"
            },
            "responsive": {
              "question": "界面支持不同屏幕尺寸吗？",
              "answer": "支持。系统保留源码原有响应式组件结构，适配桌面、平板与移动端布局。"
            },
            "themes": {
              "question": "支持浅色和深色主题吗？",
              "answer": "支持。工作台保留源码主题系统，包括浅色、深色模式以及原组件交互。"
            },
            "languages": {
              "question": "当前提供哪些界面语言？",
              "answer": "当前界面包含简体中文和英文语言资源。"
            }
          }
        }
      },
